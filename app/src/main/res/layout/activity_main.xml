<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <!-- ================= MAPA ================= -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ================= BARRA SUPERIOR NARANJA (MODO VIAJE) ================= -->
    <LinearLayout
        android:id="@+id/tripTopBarOrange"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_orange_rounded"
        android:orientation="vertical"
        android:paddingVertical="14dp"
        android:paddingHorizontal="18dp"
        android:visibility="gone"
        android:elevation="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Fila 1: Instrucción principal -->
        <TextView
            android:id="@+id/tvInstructionTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gira en Calle de la Cañada Real de Toledo"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="2"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="8dp"/>

        <!-- Fila 2: Distancia próxima + ETA total -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Icono de giro pequeño -->
            <ImageView
                android:id="@+id/ivTurnIconSmall"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="12dp"
                android:visibility="visible"
                app:tint="@android:color/white"/>

            <!-- Distancia próxima maniobra -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="start">

                <TextView
                    android:id="@+id/tvNextDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="58 m"
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvNextTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="45 min"
                    android:textColor="#E6FFFFFF"
                    android:textSize="15sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- ETA TOTAL (derecha) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/tvEtaTop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2h 43m"
                    android:textColor="@android:color/white"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:gravity="end"/>

                <TextView
                    android:id="@+id/tvTotalDistanceTop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="62.4 km"
                    android:textColor="#E6FFFFFF"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp"
                    android:gravity="end"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ================= BOTÓN CANCELAR VIAJE ================= -->
    <LinearLayout
        android:id="@+id/cancelButtonContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="16dp"
        android:visibility="gone"
        android:elevation="12dp"
        android:layout_margin="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnCancelRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancelar viaje"/>
    </LinearLayout>

    <!-- ================= PANEL DE VISTA PREVIA ================= -->
    <LinearLayout
        android:id="@+id/previewPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone"
        android:elevation="12dp"
        android:layout_margin="12dp"
        android:background="@drawable/bg_card"
        app:layout_constraintBottom_toTopOf="@id/cancelButtonContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vista previa de ruta"
            android:textColor="@color/du_on_surface_variant"
            android:textSize="13sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvPreviewRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="14dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:gravity="center"
            android:text="Origen  →  Destino"
            android:textColor="@color/du_on_surface"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <!-- Información tiempo y distancia -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_field"
            android:gravity="center">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvPreviewTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18h 31m"
                    android:textColor="@color/driveup_orange"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tiempo"
                    android:textColor="@color/du_on_surface_variant"
                    android:textSize="12sp"/>
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="40dp"
                android:background="@color/du_outline"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvPreviewDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1725.6 km"
                    android:textColor="@color/driveup_orange"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Distancia"
                    android:textColor="@color/du_on_surface_variant"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvPreviewAlt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Alternativa"
            android:textColor="@color/du_on_surface_variant"
            android:textSize="13sp"
            android:visibility="gone"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStartFromPreview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Iniciar"/>

            <Button
                android:id="@+id/btnClosePreview"
                style="@style/Widget.DriveUp.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Cerrar"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ================= BOTÓN AJUSTES (MENÚ) ================= -->
    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_round_surface"
        android:src="@drawable/ic_menu"
        android:padding="14dp"
        android:scaleType="fitCenter"
        android:elevation="8dp"
        android:contentDescription="Menú"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- ================= BOTÓN TIENDA ================= -->
    <ImageButton
        android:id="@+id/btnStore"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/ic_store_dup"
        android:scaleType="fitCenter"
        android:background="@android:color/transparent"
        android:elevation="8dp"
        android:contentDescription="Tienda"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- ================= VELOCÍMETRO ================= -->
    <FrameLayout
        android:id="@+id/speedometerContainer"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/velocimetro_drawable"
        android:elevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/routeInputContainer"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="6dp"
            android:text="0"
            android:textColor="@color/du_on_surface"
            android:textSize="24sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:text="km/h"
            android:textColor="@color/du_on_surface_variant"
            android:textSize="11sp"/>
    </FrameLayout>

    <!-- ================= BOTÓN CENTRAR ================= -->
    <ImageButton
        android:id="@+id/btnCenterLocation"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/boton_centrar"
        android:src="@drawable/ic_navigation_arrow"
        android:padding="15dp"
        android:scaleType="fitCenter"
        android:elevation="8dp"
        android:contentDescription="Centrar en mi ubicación"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/routeInputContainer"/>

    <!-- ================= PANEL DE RUTA ================= -->
    <LinearLayout
        android:id="@+id/routeInputContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="16dp"
        android:background="@drawable/bg_card"
        android:elevation="12dp"
        app:layout_constraintBottom_toTopOf="@id/previewPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="12dp"
            android:text="¿A dónde vamos?"
            android:textColor="@color/du_on_surface"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <!-- Accesos rápidos: Casa / Trabajo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnGoHome"
                style="@style/Widget.DriveUp.Button.Shortcut"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Casa"
                app:icon="@drawable/ic_home"/>

            <Button
                android:id="@+id/btnGoWork"
                style="@style/Widget.DriveUp.Button.Shortcut"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Trabajo"
                app:icon="@drawable/ic_work"/>
        </LinearLayout>

        <!-- Origen -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.DriveUp.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="Origen"
            app:startIconDrawable="@drawable/ic_origin">

            <AutoCompleteTextView
                android:id="@+id/etOrigin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:inputType="text"
                android:maxLines="1"
                android:paddingTop="22dp"
                android:paddingBottom="10dp"
                android:paddingEnd="12dp"
                android:popupBackground="@drawable/bg_popup"
                android:textColor="@color/du_on_surface"
                android:textColorHint="@color/du_on_surface_variant"
                android:textSize="15sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Destino -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.DriveUp.TextField"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Destino"
            app:startIconDrawable="@drawable/ic_place">

            <AutoCompleteTextView
                android:id="@+id/etDestination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:inputType="text"
                android:maxLines="1"
                android:paddingTop="22dp"
                android:paddingBottom="10dp"
                android:paddingEnd="12dp"
                android:popupBackground="@drawable/bg_popup"
                android:textColor="@color/du_on_surface"
                android:textColorHint="@color/du_on_surface_variant"
                android:textSize="15sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnRoute"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Iniciar ruta"/>

            <Button
                android:id="@+id/btnPreviewRoute"
                style="@style/Widget.DriveUp.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Ver ruta"/>
        </LinearLayout>

        <!-- Botón Cancelar OLD (OCULTO, se movió al panel) -->
        <Button
            android:id="@+id/btnCancelRouteOld"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancelar ruta"
            android:layout_marginTop="8dp"
            android:backgroundTint="#B00020"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- ================= BARRA INFERIOR ANTIGUA ================= -->
    <LinearLayout
        android:id="@+id/navigationBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:layout_margin="12dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:elevation="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivTurnIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerHorizontal="true"
                app:tint="@color/driveup_orange"/>

            <ImageButton
                android:id="@+id/btnMute"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                android:contentDescription="Silenciar voz"
                app:tint="@color/driveup_orange"/>
        </RelativeLayout>

        <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp"
            android:textColor="@color/du_on_surface"
            android:gravity="center"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvStepDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/du_on_surface"
                android:textStyle="bold"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:id="@+id/tvEta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@color/du_on_surface_variant"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
