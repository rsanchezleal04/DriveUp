<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ================= MAPA ================= -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ================= BARRA SUPERIOR NARANJA (MODO VIAJE) ================= -->
    <LinearLayout
        android:id="@+id/tripTopBarOrange"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_orange_rounded"
        android:orientation="vertical"
        android:paddingVertical="12dp"
        android:paddingHorizontal="16dp"
        android:visibility="gone"
        android:elevation="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Fila 1: Instrucción principal -->
        <TextView
            android:id="@+id/tvInstructionTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gira en Calle de la Cañada Real de Toledo"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="2"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="6dp"/>

        <!-- Fila 2: Distancia próxima + ETA total -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Icono de giro pequeño -->
            <ImageView
                android:id="@+id/ivTurnIconSmall"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp"
                android:visibility="visible"
                app:tint="@android:color/white"/>

            <!-- Distancia próxima maniobra (SOLO DISTANCIA) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="start">

                <TextView
                    android:id="@+id/tvNextDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="56 m"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <!-- ELIMINADO: TextView tvNextTime -->
            </LinearLayout>

            <!-- ETA TOTAL (derecha) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <!-- Tiempo total restante -->
                <TextView
                    android:id="@+id/tvEtaTop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2h 43m"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="end"/>

                <!-- Distancia total restante -->
                <TextView
                    android:id="@+id/tvTotalDistanceTop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="240.6 km"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp"
                    android:gravity="end"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ================= BOTÓN AJUSTES ================= -->
    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_circle_white"
        android:src="@drawable/ic_menu"
        android:padding="10dp"
        android:elevation="8dp"
        android:contentDescription="Menú"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tripTopBarOrange"/>

    <!-- ================= BOTÓN TIENDA ================= -->
    <FrameLayout
        android:id="@+id/storeButtonContainer"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_circle_white"
        android:elevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tripTopBarOrange">

        <ImageButton
            android:id="@+id/btnStore"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_store"
            app:tint="@color/driveup_orange"/>
    </FrameLayout>

    <!-- ================= VELOCÍMETRO ================= -->
    <FrameLayout
        android:id="@+id/speedometerContainer"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/velocimetro_drawable"
        android:elevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/routeInputContainer"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="0"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="10dp"
            android:text="Km/h"
            android:textColor="@android:color/white"
            android:textSize="11sp"/>
    </FrameLayout>

    <!-- ================= BOTÓN CENTRAR ================= -->
    <ImageButton
        android:id="@+id/btnCenterLocation"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/boton_centrar"
        android:src="@android:drawable/ic_menu_mylocation"
        android:elevation="8dp"
        app:tint="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/routeInputContainer"/>

    <!-- ================= INPUT RUTA ================= -->
    <LinearLayout
        android:id="@+id/routeInputContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="@drawable/bg_panel_dark"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <AutoCompleteTextView
                android:id="@+id/etOrigin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Mi ubicación"
                android:textColor="@android:color/white"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <AutoCompleteTextView
                android:id="@+id/etDestination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Destino"
                android:textColor="@android:color/white"/>
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Iniciar ruta"
            android:backgroundTint="@color/driveup_orange"
            android:textColor="@android:color/white"/>

        <Button
            android:id="@+id/btnPreviewRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ver ruta"
            android:layout_marginTop="4dp"
            android:backgroundTint="@color/driveup_orange"
            android:textColor="@android:color/white"/>

        <Button
            android:id="@+id/btnCancelRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancelar ruta"
            android:backgroundTint="#B00020"
            android:textColor="@android:color/white"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- ================= BARRA INFERIOR (PARA PREVIEW) ================= -->
    <LinearLayout
        android:id="@+id/navigationBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="vertical"
        android:background="@drawable/bg_panel_dark"
        android:elevation="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivTurnIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerHorizontal="true"
                app:tint="@color/driveup_orange"/>

            <ImageButton
                android:id="@+id/btnMute"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                app:tint="@color/driveup_orange"/>
        </RelativeLayout>

        <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:gravity="center"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvStepDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:id="@+id/tvEta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@android:color/white"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>