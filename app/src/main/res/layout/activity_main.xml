<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ================= MAPA ================= -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ================= BARRA SUPERIOR NARANJA (MODO VIAJE) ================= -->
    <LinearLayout
        android:id="@+id/tripTopBarOrange"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_orange_rounded"
        android:orientation="vertical"
        android:paddingVertical="12dp"
        android:paddingHorizontal="16dp"
        android:visibility="gone"
        android:elevation="12dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Fila 1: Instrucción principal -->
        <TextView
            android:id="@+id/tvInstructionTop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gira en Calle de la Cañada Real de Toledo"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="2"
            android:lineSpacingExtra="2dp"
            android:layout_marginBottom="6dp"/>

        <!-- Fila 2: Distancia próxima + ETA total -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Icono de giro pequeño -->
            <ImageView
                android:id="@+id/ivTurnIconSmall"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="10dp"
                android:visibility="visible"
                app:tint="@android:color/white"/>

            <!-- Distancia próxima maniobra -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="start">

                <TextView
                    android:id="@+id/tvNextDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="58 m"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <!-- Tiempo próximo (como en la imagen) -->
                <TextView
                    android:id="@+id/tvNextTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="45 min"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <!-- ETA TOTAL (derecha) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <!-- Tiempo total restante -->
                <TextView
                    android:id="@+id/tvEtaTop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2h 43m"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:gravity="end"/>

                <!-- Distancia total restante -->
                <TextView
                    android:id="@+id/tvTotalDistanceTop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="62.4 km"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp"
                    android:gravity="end"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ================= BOTÓN CANCELAR VIAJE ================= -->
    <LinearLayout
        android:id="@+id/cancelButtonContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_white_with_orange_border"
        android:padding="16dp"
        android:visibility="gone"
        android:elevation="12dp"
        android:layout_margin="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnCancelRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CANCELAR VIAJE"
            android:textAllCaps="true"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="@color/driveup_orange"
            android:paddingVertical="14dp"
            android:minHeight="50dp"/>
    </LinearLayout>

    <!-- ================= PANEL DE VISTA PREVIA ================= -->
    <LinearLayout
        android:id="@+id/previewPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone"
        android:elevation="12dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_white_with_orange_border"
        app:layout_constraintBottom_toTopOf="@id/cancelButtonContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="VISTA PREVIA DE RUTA"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- Información tiempo y distancia -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp"
            android:gravity="center">

            <!-- Información tiempo -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvPreviewTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="18h 31m"
                    android:textColor="@android:color/black"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tiempo"
                    android:textColor="#666666"
                    android:textSize="12sp"/>
            </LinearLayout>

            <!-- Separador -->
            <View
                android:layout_width="1dp"
                android:layout_height="40dp"
                android:background="#E0E0E0"/>

            <!-- Información distancia -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tvPreviewDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1725.6 km"
                    android:textColor="@android:color/black"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Distancia"
                    android:textColor="#666666"
                    android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnStartFromPreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INICIAR"
                android:layout_marginEnd="8dp"
                android:backgroundTint="@color/driveup_orange"
                android:textColor="@android:color/white"
                android:paddingHorizontal="24dp"
                android:minWidth="100dp"
                android:minHeight="44dp"/>

            <Button
                android:id="@+id/btnClosePreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CERRAR"
                android:backgroundTint="#666666"
                android:textColor="@android:color/white"
                android:paddingHorizontal="24dp"
                android:minWidth="100dp"
                android:minHeight="44dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ================= BOTÓN AJUSTES ================= -->
    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_circle_white"
        android:src="@drawable/ic_menu"
        android:padding="10dp"
        android:elevation="8dp"
        android:contentDescription="Menú"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- ================= BOTÓN TIENDA ================= -->
    <FrameLayout
        android:id="@+id/storeButtonContainer"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_circle_white"
        android:elevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="16dp">

        <ImageButton
            android:id="@+id/btnStore"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_store"
            app:tint="@color/driveup_orange"/>
    </FrameLayout>

    <!-- ================= VELOCÍMETRO ================= -->
    <FrameLayout
        android:id="@+id/speedometerContainer"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/velocimetro_drawable"
        android:elevation="8dp"
        app:layout_constraintBottom_toTopOf="@id/routeInputContainer"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="0"
            android:textColor="@android:color/white"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="10dp"
            android:text="Km/h"
            android:textColor="@android:color/white"
            android:textSize="11sp"/>
    </FrameLayout>

    <!-- ================= BOTÓN CENTRAR ================= -->
    <ImageButton
        android:id="@+id/btnCenterLocation"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/boton_centrar"
        android:src="@android:drawable/ic_menu_mylocation"
        android:elevation="8dp"
        app:tint="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/routeInputContainer"/>

    <!-- ================= INPUT RUTA MEJORADO ================= -->
    <LinearLayout
        android:id="@+id/routeInputContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="14dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/bg_white_with_orange_border"
        android:elevation="12dp"
        app:layout_constraintBottom_toTopOf="@id/previewPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Origen (con etiqueta "ORIGEN:" a la izquierda) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <!-- Etiqueta ORIGEN con ancho fijo -->
            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="ORIGEN:"
                android:textColor="@color/driveup_orange"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="end"
                android:layout_marginEnd="12dp"
                android:includeFontPadding="false"
                android:paddingBottom="2dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxStrokeColor="@color/driveup_orange"
                app:hintTextColor="@android:color/black"
                app:boxStrokeWidth="2dp"
                app:boxCornerRadiusTopStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusBottomEnd="8dp">

                <AutoCompleteTextView
                    android:id="@+id/etOrigin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Mi ubicación"
                    android:textColor="@android:color/black"
                    android:backgroundTint="@color/driveup_orange"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Destino (con etiqueta "DESTINO:" a la izquierda) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <!-- Etiqueta DESTINO con MISMO ancho fijo -->
            <TextView
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:text="DESTINO:"
                android:textColor="@color/driveup_orange"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="end"
                android:layout_marginEnd="12dp"
                android:includeFontPadding="false"
                android:paddingBottom="2dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxStrokeColor="@color/driveup_orange"
                app:hintTextColor="@android:color/black"
                app:boxStrokeWidth="2dp"
                app:boxCornerRadiusTopStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusBottomEnd="8dp">

                <AutoCompleteTextView
                    android:id="@+id/etDestination"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Introduce destino"
                    android:textColor="@android:color/black"
                    android:backgroundTint="@color/driveup_orange"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Botones en horizontal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <!-- Botón Iniciar Ruta -->
            <Button
                android:id="@+id/btnRoute"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Iniciar ruta"
                android:backgroundTint="@color/driveup_orange"
                android:textColor="@android:color/white"
                android:minHeight="48dp"/>

            <!-- Botón Ver Ruta -->
            <Button
                android:id="@+id/btnPreviewRoute"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Ver ruta"
                android:backgroundTint="@color/driveup_orange"
                android:textColor="@android:color/white"
                android:minHeight="48dp"/>
        </LinearLayout>

        <!-- Botón Cancelar OLD (OCULTO, se movió al panel) -->
        <Button
            android:id="@+id/btnCancelRouteOld"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancelar ruta"
            android:layout_marginTop="8dp"
            android:backgroundTint="#B00020"
            android:textColor="@android:color/white"
            android:visibility="gone"
            android:minHeight="48dp"/>
    </LinearLayout>

    <!-- ================= BARRA INFERIOR ANTIGUA ================= -->
    <LinearLayout
        android:id="@+id/navigationBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="vertical"
        android:background="@drawable/bg_panel_dark"
        android:elevation="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/ivTurnIcon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_centerHorizontal="true"
                app:tint="@color/driveup_orange"/>

            <ImageButton
                android:id="@+id/btnMute"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:background="@android:color/transparent"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                app:tint="@color/driveup_orange"/>
        </RelativeLayout>

        <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:gravity="center"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/tvStepDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:id="@+id/tvEta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@android:color/white"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>