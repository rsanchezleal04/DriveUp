<?xml version="1.0" encoding="utf-8"?>
<!-- Aviso de puntos insuficientes en la tienda -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="20dp">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_icon_soft_orange"
        android:contentDescription="@null"
        android:padding="16dp"
        android:src="@drawable/ic_star_points"
        app:tint="@color/driveup_orange" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="¡Casi lo tienes!"
        android:textColor="@color/du_on_surface"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvNepMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="Te faltan 4.500 pts para Amazon Prime"
        android:textColor="@color/du_on_surface_variant"
        android:textSize="15sp" />

    <!-- Progreso hacia el premio -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressNep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:max="100"
        app:indicatorColor="@color/driveup_orange"
        app:trackColor="@color/du_surface_variant"
        app:trackCornerRadius="100dp"
        app:trackThickness="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvNepHave"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tienes 0 pts"
            android:textColor="@color/du_on_surface_variant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvNepNeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4.500 pts"
            android:textColor="@color/driveup_orange"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="Sigue conduciendo de forma segura para sumar puntos 🚗"
        android:textColor="@color/du_on_surface_variant"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnNepOk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Entendido" />
</LinearLayout>
