<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta con borde naranja; el fondo sigue el tema claro/oscuro -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/du_surface" />
    <stroke
        android:width="1.5dp"
        android:color="@color/driveup_orange" />
    <corners android:radius="24dp" />
    <padding
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp" />
</shape>
