<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema base: los colores de superficie vienen de values/colors.xml y values-night/colors.xml,
         así claro y oscuro comparten este mismo tema. -->
    <style name="Theme.DriveUp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/driveup_orange</item>
        <item name="colorPrimaryVariant">@color/driveup_orange_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/driveup_orange</item>
        <item name="colorSecondaryVariant">@color/driveup_orange_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:colorBackground">@color/du_background</item>
        <item name="colorSurface">@color/du_surface</item>
        <item name="colorOnSurface">@color/du_on_surface</item>
        <item name="colorOnBackground">@color/du_on_surface</item>
        <item name="android:textColorPrimary">@color/du_on_surface</item>
        <item name="android:textColorSecondary">@color/du_on_surface_variant</item>

        <!-- Barras del sistema a juego con el fondo -->
        <item name="android:statusBarColor">@color/du_background</item>
        <item name="android:navigationBarColor">@color/du_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Menús emergentes y diálogos redondeados que siguen el tema -->
        <item name="popupMenuStyle">@style/Widget.DriveUp.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Widget.DriveUp.PopupMenu</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.DriveUp.Dialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.DriveUp.Dialog</item>
        <item name="materialButtonStyle">@style/Widget.DriveUp.Button</item>
    </style>

    <!-- Pantallas siempre oscuras (login, verificación) -->
    <style name="Theme.DriveUp.Dark" parent="Theme.DriveUp">
        <item name="android:statusBarColor">#FF111111</item>
        <item name="android:navigationBarColor">#FF111111</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <!-- Tienda: barra de estado naranja a juego con la cabecera -->
    <style name="Theme.DriveUp.Store" parent="Theme.DriveUp">
        <item name="android:statusBarColor">#FFFF9A22</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Widget.DriveUp.PopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup</item>
        <item name="android:popupElevation">8dp</item>
    </style>

    <style name="ThemeOverlay.DriveUp.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorPrimary">@color/driveup_orange</item>
        <item name="colorSurface">@color/du_surface</item>
        <item name="colorOnSurface">@color/du_on_surface</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.DriveUp.Large</item>
    </style>

    <style name="ShapeAppearance.DriveUp.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <style name="ShapeAppearance.DriveUp.StoreImage" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <!-- Filas del menú de ajustes -->
    <style name="DriveUp.MenuRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="DriveUp.MenuRow.Icon" parent="">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:padding">8dp</item>
        <item name="android:background">@drawable/bg_icon_soft_orange</item>
        <item name="tint">@color/driveup_orange</item>
    </style>
    <style name="DriveUp.MenuRow.Title" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/du_on_surface</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="DriveUp.MenuSwitch" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
    </style>

    <!-- Selector de tipo de mapa -->
    <style name="DriveUp.MapTile" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">104dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_map_tile</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:duplicateParentState">false</item>
    </style>
    <style name="DriveUp.MapTile.Icon" parent="">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">32dp</item>
        <item name="android:duplicateParentState">true</item>
        <item name="tint">@color/map_tile_content</item>
    </style>
    <style name="DriveUp.MapTile.Label" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:duplicateParentState">true</item>
        <item name="android:textColor">@color/map_tile_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Chips de categoría de la tienda -->
    <style name="Widget.DriveUp.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipStrokeColor">@color/du_outline</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">100dp</item>
        <item name="chipMinHeight">38dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:checkable">true</item>
        <item name="android:clickable">true</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <!-- Botones -->
    <style name="Widget.DriveUp.Button" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/driveup_orange</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Widget.DriveUp.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/driveup_orange</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textColor">@color/driveup_orange</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Accesos rápidos (Casa / Trabajo): píldora suave con icono naranja -->
    <style name="Widget.DriveUp.Button.Shortcut" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="backgroundTint">@color/du_surface_variant</item>
        <item name="android:textColor">@color/du_on_surface</item>
        <item name="iconTint">@color/driveup_orange</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconGravity">textStart</item>
        <item name="cornerRadius">100dp</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Campos de texto rellenos, sin línea inferior -->
    <style name="Widget.DriveUp.TextField" parent="Widget.MaterialComponents.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/du_surface_variant</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">@color/driveup_orange</item>
        <item name="android:textColorHint">@color/du_on_surface_variant</item>
        <item name="startIconTint">@color/driveup_orange</item>
    </style>
</resources>
